<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>TTC_GUI</AssemblyName>
    <RootNamespace>TTC.Gui</RootNamespace>
    <AssemblyTitle>TTC 幻卡助手</AssemblyTitle>
    <Product>TTC GUI</Product>
    <ApplicationIcon>Assets\ttcicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TTC.Core\TTC.Core.csproj" />
    <ProjectReference Include="..\TTC.Search\TTC.Search.csproj" />
    <ProjectReference Include="..\TTC.Engine\TTC.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\幻卡数据库.csv" Link="Data\幻卡数据库.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\card_pinyin.json" Link="Data\card_pinyin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
