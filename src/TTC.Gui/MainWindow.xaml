<ui:FluentWindow x:Class="TTC.Gui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="TTC 幻卡助手"
                 Width="1280" Height="900"
                 MinWidth="1080" MinHeight="840"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFD48A"/>
                                <Setter Property="Foreground" Value="#FFD48A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="TTC 幻卡助手"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边导航 -->
            <Border Grid.Column="0" Background="#14FFFFFF" CornerRadius="0,12,12,0" Margin="8,8,0,8">
                <StackPanel Margin="10,16,10,10">
                    <TextBlock Text="TTC 幻卡助手" FontSize="20" FontWeight="Bold" Margin="8,0,0,2"/>
                    <TextBlock Text="最终幻想14 · 九宫幻卡求解器" Foreground="#999999" FontSize="11" Margin="8,0,0,16"/>

                    <RadioButton x:Name="NavSolve" AutomationProperties.AutomationId="NavSolve" Style="{StaticResource NavItemStyle}" Content="对局求解"
                                 IsChecked="True" Checked="OnNavSolve" GroupName="Nav"/>
                    <RadioButton x:Name="NavDecks" AutomationProperties.AutomationId="NavDecks" Style="{StaticResource NavItemStyle}" Content="我的卡组"
                                 Checked="OnNavDecks" GroupName="Nav" Margin="0,4,0,0"/>
                    <RadioButton x:Name="NavDraft" AutomationProperties.AutomationId="NavDraft" Style="{StaticResource NavItemStyle}" Content="选拔分析"
                                 Checked="OnNavDraft" GroupName="Nav" Margin="0,4,0,0"/>

                    <StackPanel Margin="8,24,8,0">
                        <TextBlock Text="引擎" Foreground="#777777" FontSize="11"/>
                        <TextBlock Text="C# Minimax + α-β 剪枝" Foreground="#AAAAAA" FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock Text="信息集残局求解" Foreground="#AAAAAA" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 内容区 -->
            <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="4,8,8,8"/>
        </Grid>

        <Border Grid.Row="2" Background="#10FFFFFF" Padding="12,6">
            <TextBlock x:Name="StatusLine" Text="就绪。" Foreground="#888888" FontSize="11"/>
        </Border>
    </Grid>
</ui:FluentWindow>
