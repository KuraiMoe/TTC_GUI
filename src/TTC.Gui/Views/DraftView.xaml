<UserControl x:Class="TTC.Gui.Views.DraftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:TTC.Gui.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
        <StackPanel>
            <TextBlock Text="选拔分析（三段备选 → 最优组合）" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <!-- 三段候选 -->
            <Border Background="#22FFFFFF" CornerRadius="12" Padding="14">
                <StackPanel>
                    <TextBlock Text="备选 1（二选一 · 每组 2 张）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Stages1}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16000000" CornerRadius="8" Margin="0,0,10,0" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Cards}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,6,0" Padding="0" BorderThickness="0" Background="Transparent"
                                                            Cursor="Hand" Click="OnPickClick">
                                                        <controls:CardTile Width="82" Height="102"
                                                                           Card="{Binding Card}"
                                                                           CenterLabel="{Binding DisplayName}"
                                                                           Accent="#666666" BackBrush="#2C2C2C"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="备选 2（二选一 · 每组 2 张）" FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <ItemsControl ItemsSource="{Binding Stages2}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16000000" CornerRadius="8" Margin="0,0,10,0" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Cards}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,6,0" Padding="0" BorderThickness="0" Background="Transparent"
                                                            Cursor="Hand" Click="OnPickClick">
                                                        <controls:CardTile Width="82" Height="102"
                                                                           Card="{Binding Card}"
                                                                           CenterLabel="{Binding DisplayName}"
                                                                           Accent="#666666" BackBrush="#2C2C2C"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="备选 3（二选一 · 每组 1 张）" FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <ItemsControl ItemsSource="{Binding Stages3}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16000000" CornerRadius="8" Margin="0,0,10,0" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Cards}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,6,0" Padding="0" BorderThickness="0" Background="Transparent"
                                                            Cursor="Hand" Click="OnPickClick">
                                                        <controls:CardTile Width="82" Height="102"
                                                                           Card="{Binding Card}"
                                                                           CenterLabel="{Binding DisplayName}"
                                                                           Accent="#666666" BackBrush="#2C2C2C"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 规则与预算 -->
            <Border Background="#18FFFFFF" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="特殊规则（最多取前 2 项，「选拔」始终生效）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0" Grid.Column="0" Content="同数" IsChecked="{Binding RuleSame}" Margin="0,4,8,4"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="加算" IsChecked="{Binding RulePlus}" Margin="0,4,8,4"/>
                        <CheckBox Grid.Row="0" Grid.Column="2" Content="逆转" IsChecked="{Binding RuleReverse}" Margin="0,4,8,4"/>
                        <CheckBox Grid.Row="0" Grid.Column="3" Content="王牌杀手" IsChecked="{Binding RuleFallenAce}" Margin="0,4,8,4"/>
                        <CheckBox Grid.Row="1" Grid.Column="0" Content="同类强化" IsChecked="{Binding RuleAscension}" Margin="0,4,8,4"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="同类弱化" IsChecked="{Binding RuleDescension}" Margin="0,4,8,4"/>
                        <CheckBox Grid.Row="1" Grid.Column="2" Content="秩序" IsChecked="{Binding RuleOrder}" Margin="0,4,8,4"/>
                        <CheckBox Grid.Row="1" Grid.Column="3" Content="混乱" IsChecked="{Binding RuleChaos}" Margin="0,4,8,4"/>
                    </Grid>

                    <TextBlock Text="深算预算（秒）" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="220" Minimum="5" Maximum="20" Value="{Binding TimeBudget}"/>
                        <TextBlock Text="{Binding TimeBudget, StringFormat={}{0:0.0}}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button x:Name="AnalyzeButton" AutomationProperties.AutomationId="AnalyzeButton" Content="开始分析" Appearance="Primary" Command="{Binding AnalyzeCommand}" MinWidth="110"/>
                        <ui:Button x:Name="RandomFillButton" AutomationProperties.AutomationId="RandomFillButton" Content="随机填充" Command="{Binding RandomFillCommand}" Margin="8,0,0,0"/>
                        <ui:Button Content="清空" Command="{Binding ClearCommand}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#999999"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 结果 -->
            <TextBlock Text="分析结果" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#18FFFFFF" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14" Foreground="#FFD48A"/>
                                <TextBlock Text="{Binding Components}" Margin="0,4,0,0" Foreground="#CCCCCC"/>
                                <ItemsControl ItemsSource="{Binding Score.Deck}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:CardTile Width="72" Height="90" Margin="0,0,6,0"
                                                               Card="{Binding}" Accent="#7A7A7A" BackBrush="#2C2C2C"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,8,0,0" Foreground="#BBBBBB" TextWrapping="Wrap">
                                    <Run Text="理由："/><Run Text="{Binding Score.ReasonsList, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" Foreground="#E0A0A0" TextWrapping="Wrap">
                                    <Run Text="风险："/><Run Text="{Binding Score.WarningList, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 日志 -->
            <TextBlock Text="分析日志" FontWeight="SemiBold" Margin="0,8,0,6"/>
            <Border Background="#14FFFFFF" CornerRadius="10" Padding="12">
                <ListBox ItemsSource="{Binding ProcessLog}" MaxHeight="200" BorderThickness="0"
                         Background="Transparent" Foreground="#999999" FontSize="12"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
