<ui:FluentWindow x:Class="TTC.Gui.Views.CardPickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="选择卡牌"
                 Width="720" Height="560"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="选择卡牌"/>

        <StackPanel Grid.Row="1" Margin="16,4,16,8" Orientation="Horizontal">
            <ui:TextBox x:Name="SearchBox" Width="240" PlaceholderText="搜索名称或编号…"
                        TextChanged="OnSearchChanged"/>
            <WrapPanel Margin="12,0,0,0" Orientation="Horizontal">
                <RadioButton x:Name="StarAll" Content="全部" IsChecked="True" Checked="OnSearchChanged" Margin="0,0,8,0"/>
                <RadioButton Content="★1" Tag="1" Checked="OnSearchChanged" Margin="0,0,8,0"/>
                <RadioButton Content="★2" Tag="2" Checked="OnSearchChanged" Margin="0,0,8,0"/>
                <RadioButton Content="★3" Tag="3" Checked="OnSearchChanged" Margin="0,0,8,0"/>
                <RadioButton Content="★4" Tag="4" Checked="OnSearchChanged" Margin="0,0,8,0"/>
                <RadioButton Content="★5" Tag="5" Checked="OnSearchChanged" Margin="0,0,8,0"/>
            </WrapPanel>
        </StackPanel>

        <ListBox x:Name="CardList" Grid.Row="2" Margin="16,0,16,0"
                 MouseDoubleClick="OnCardDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="4" Padding="3,1">
                            <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Margin="8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="#999999" VerticalAlignment="Center">
                            <Run Text="上"/><Run Text="{Binding EdgeText0, Mode=OneWay}"/><Run Text="  右"/><Run Text="{Binding EdgeText1, Mode=OneWay}"/><Run Text="  下"/><Run Text="{Binding EdgeText2, Mode=OneWay}"/><Run Text="  左"/><Run Text="{Binding EdgeText3, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="3" Text="{Binding StarText}" Foreground="#FFD48A"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="16,12,16,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button x:Name="PickUnknownButton" Content="设为未知牌" Click="OnPickUnknown" Margin="0,0,8,0"/>
                <ui:Button Content="清除" Appearance="Secondary" Click="OnPickClear" Margin="0,0,8,0"/>
                <ui:Button Content="取消" Appearance="Secondary" Click="OnCancel" Margin="0,0,8,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="OwnerLabel" Text="归属：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="OwnerBlue" Content="蓝方" IsChecked="True" Margin="0,0,8,0"/>
                <RadioButton x:Name="OwnerRed" Content="红方" Margin="0,0,12,0"/>
                <ui:Button x:Name="PickSelectButton" Content="选择" Appearance="Primary" Click="OnPickSelected"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
