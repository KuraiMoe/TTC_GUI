<UserControl x:Class="TTC.Gui.Views.SolveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:TTC.Gui.Controls">
    <UserControl.Resources>
        <!-- 搜索进度表：统一暗色风格 -->
        <Style x:Key="DepthGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#22FFFFFF"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#0AFFFFFF"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, sans-serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#24FFD48A"/>
                    <Setter Property="Foreground" Value="#FFE9C88A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0,8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NumCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 拖动中的整卡浮层 -->
        <Style x:Key="SlotButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <!-- 拖动浮层：整张卡跟随鼠标 -->
        <Popup x:Name="DragPopup" Placement="Relative" PlacementTarget="{Binding ElementName=RootGrid}" AllowsTransparency="True"
               PopupAnimation="Fade" IsOpen="False" IsHitTestVisible="False">
            <Border CornerRadius="10" Opacity="0.92">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.55"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DragScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <controls:CardTile x:Name="DragTile" Width="96" Height="118"
                                   Accent="#FFD48A" BackBrush="#2C3A52"/>
            </Border>
        </Popup>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ══════════ 左：棋盘与手牌 ══════════ -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="棋盘（拖动手牌到棋盘落子）" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Border Background="#22FFFFFF" CornerRadius="12" Padding="12" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding BoardCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="3" Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SlotButtonStyle}"
                                            Click="OnBoardSlotClick"
                                            PreviewMouseLeftButtonDown="OnSlotMouseDown"
                                            PreviewMouseMove="OnSlotMouseMove"
                                            PreviewMouseLeftButtonUp="OnSlotMouseUp"
                                            AutomationProperties.AutomationId="{Binding AutomationKey}"
                                            ToolTip="{Binding Title}">
                                        <controls:CardTile Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                           Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"
                                                           Highlight="{Binding IsRecommended}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 蓝方手牌：五环型 3 + 2 -->
                        <StackPanel Grid.Column="0" x:Name="HandBlueZone" Tag="1">
                            <TextBlock Text="{Binding BlueHandTitle}" Foreground="#5A9BD5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SlotButtonStyle}" DataContext="{Binding HandBlue[0]}"
                                        Click="OnHandSlotClick" PreviewMouseLeftButtonDown="OnSlotMouseDown"
                                        PreviewMouseMove="OnSlotMouseMove" PreviewMouseLeftButtonUp="OnSlotMouseUp"
                                        AutomationProperties.AutomationId="{Binding AutomationKey}" ToolTip="{Binding Title}">
                                    <controls:CardTile Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                       Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"
                                                       Highlight="{Binding IsPlayed}"/>
                                </Button>
                                <Button Style="{StaticResource SlotButtonStyle}" DataContext="{Binding HandBlue[1]}"
                                        Click="OnHandSlotClick" PreviewMouseLeftButtonDown="OnSlotMouseDown"
                                        PreviewMouseMove="OnSlotMouseMove" PreviewMouseLeftButtonUp="OnSlotMouseUp"
                                        AutomationProperties.AutomationId="{Binding AutomationKey}" ToolTip="{Binding Title}">
                                    <controls:CardTile Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                       Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"
                                                       Highlight="{Binding IsPlayed}"/>
                                </Button>
                                <Button Style="{StaticResource SlotButtonStyle}" DataContext="{Binding HandBlue[2]}"
                                        Click="OnHandSlotClick" PreviewMouseLeftButtonDown="OnSlotMouseDown"
                                        PreviewMouseMove="OnSlotMouseMove" PreviewMouseLeftButtonUp="OnSlotMouseUp"
                                        AutomationProperties.AutomationId="{Binding AutomationKey}" ToolTip="{Binding Title}">
                                    <controls:CardTile Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                       Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"
                                                       Highlight="{Binding IsPlayed}"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SlotButtonStyle}" DataContext="{Binding HandBlue[3]}"
                                        Click="OnHandSlotClick" PreviewMouseLeftButtonDown="OnSlotMouseDown"
                                        PreviewMouseMove="OnSlotMouseMove" PreviewMouseLeftButtonUp="OnSlotMouseUp"
                                        AutomationProperties.AutomationId="{Binding AutomationKey}" ToolTip="{Binding Title}">
                                    <controls:CardTile Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                       Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"
                                                       Highlight="{Binding IsPlayed}"/>
                                </Button>
                                <Button Style="{StaticResource SlotButtonStyle}" DataContext="{Binding HandBlue[4]}"
                                        Click="OnHandSlotClick" PreviewMouseLeftButtonDown="OnSlotMouseDown"
                                        PreviewMouseMove="OnSlotMouseMove" PreviewMouseLeftButtonUp="OnSlotMouseUp"
                                        AutomationProperties.AutomationId="{Binding AutomationKey}" ToolTip="{Binding Title}">
                                    <controls:CardTile Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                       Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"
                                                       Highlight="{Binding IsPlayed}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- 红方手牌：五环型 3 + 2 -->
                        <StackPanel Grid.Column="1" x:Name="HandRedZone" Tag="0">
                            <TextBlock Text="{Binding RedHandTitle}" Foreground="#D96A6A" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SlotButtonStyle}" DataContext="{Binding HandRed[0]}"
                                        Click="OnHandSlotClick" PreviewMouseLeftButtonDown="OnSlotMouseDown"
                                        PreviewMouseMove="OnSlotMouseMove" PreviewMouseLeftButtonUp="OnSlotMouseUp"
                                        AutomationProperties.AutomationId="{Binding AutomationKey}" ToolTip="{Binding Title}">
                                    <controls:CardTile Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                       Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"
                                                       Highlight="{Binding IsPlayed}"/>
                                </Button>
                                <Button Style="{StaticResource SlotButtonStyle}" DataContext="{Binding HandRed[1]}"
                                        Click="OnHandSlotClick" PreviewMouseLeftButtonDown="OnSlotMouseDown"
                                        PreviewMouseMove="OnSlotMouseMove" PreviewMouseLeftButtonUp="OnSlotMouseUp"
                                        AutomationProperties.AutomationId="{Binding AutomationKey}" ToolTip="{Binding Title}">
                                    <controls:CardTile Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                       Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"
                                                       Highlight="{Binding IsPlayed}"/>
                                </Button>
                                <Button Style="{StaticResource SlotButtonStyle}" DataContext="{Binding HandRed[2]}"
                                        Click="OnHandSlotClick" PreviewMouseLeftButtonDown="OnSlotMouseDown"
                                        PreviewMouseMove="OnSlotMouseMove" PreviewMouseLeftButtonUp="OnSlotMouseUp"
                                        AutomationProperties.AutomationId="{Binding AutomationKey}" ToolTip="{Binding Title}">
                                    <controls:CardTile Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                       Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"
                                                       Highlight="{Binding IsPlayed}"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SlotButtonStyle}" DataContext="{Binding HandRed[3]}"
                                        Click="OnHandSlotClick" PreviewMouseLeftButtonDown="OnSlotMouseDown"
                                        PreviewMouseMove="OnSlotMouseMove" PreviewMouseLeftButtonUp="OnSlotMouseUp"
                                        AutomationProperties.AutomationId="{Binding AutomationKey}" ToolTip="{Binding Title}">
                                    <controls:CardTile Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                       Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"
                                                       Highlight="{Binding IsPlayed}"/>
                                </Button>
                                <Button Style="{StaticResource SlotButtonStyle}" DataContext="{Binding HandRed[4]}"
                                        Click="OnHandSlotClick" PreviewMouseLeftButtonDown="OnSlotMouseDown"
                                        PreviewMouseMove="OnSlotMouseMove" PreviewMouseLeftButtonUp="OnSlotMouseUp"
                                        AutomationProperties.AutomationId="{Binding AutomationKey}" ToolTip="{Binding Title}">
                                    <controls:CardTile Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                       Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"
                                                       Highlight="{Binding IsPlayed}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- ══════════ 右：设置与结果 ══════════ -->
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="对局设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Border Background="#18FFFFFF" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="当前行动方" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="蓝方" IsChecked="{Binding IsBlueTurn}" Margin="0,0,16,0"/>
                                <RadioButton Content="红方" IsChecked="{Binding IsRedTurn}"/>
                            </StackPanel>

                            <TextBlock Text="我方（你的阵营）" FontWeight="SemiBold" Margin="0,12,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="蓝方" IsChecked="{Binding IsMySideBlue}" Margin="0,0,16,0"/>
                                <RadioButton Content="红方" IsChecked="{Binding IsMySideRed}"/>
                            </StackPanel>

                            <TextBlock Text="特殊规则" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <CheckBox Grid.Row="0" Grid.Column="0" Content="同数" IsChecked="{Binding RuleSame}" Margin="0,4,8,4"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Content="加算" IsChecked="{Binding RulePlus}" Margin="0,4,8,4"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" Content="逆转" IsChecked="{Binding RuleReverse}" Margin="0,4,8,4"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Content="王牌杀手" IsChecked="{Binding RuleFallenAce}" Margin="0,4,8,4"/>
                                <CheckBox Grid.Row="2" Grid.Column="0" Content="同类强化" IsChecked="{Binding RuleAscension}" Margin="0,4,8,4"/>
                                <CheckBox Grid.Row="2" Grid.Column="1" Content="同类弱化" IsChecked="{Binding RuleDescension}" Margin="0,4,8,4"/>
                                <CheckBox Grid.Row="3" Grid.Column="0" Content="秩序" IsChecked="{Binding RuleOrder}" Margin="0,4,8,4"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" Content="混乱" IsChecked="{Binding RuleChaos}" Margin="0,4,8,4"/>
                            </Grid>

                            <TextBlock Text="搜索时间（秒）" FontWeight="SemiBold" Margin="0,10,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="0.5" Maximum="30" Value="{Binding MaxSeconds}" TickFrequency="0.5"/>
                                <TextBlock Text="{Binding MaxSeconds, StringFormat={}{0:0.0}}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="搜索深度" FontWeight="SemiBold" Margin="0,10,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="1" Maximum="100" Value="{Binding MaxDepth}"/>
                                <TextBlock Text="{Binding MaxDepth}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="未知牌采样数" FontWeight="SemiBold" Margin="0,10,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="4" Maximum="24" Value="{Binding Samples}"/>
                                <TextBlock Text="{Binding Samples}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CheckBox Content="激进模式（高风险偏好）" IsChecked="{Binding Aggressive}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button AutomationProperties.AutomationId="SolveButton" Content="开始求解" Appearance="Primary" Command="{Binding SolveCommand}" MinWidth="110"/>
                        <ui:Button Content="取消" Command="{Binding CancelCommand}" Margin="8,0,0,0"/>
                        <ui:Button AutomationProperties.AutomationId="DemoButton" Content="示例局面" Command="{Binding DemoCommand}" Margin="8,0,0,0"/>
                        <ui:Button Content="清空" Command="{Binding ClearCommand}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Border Background="#18FFFFFF" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="求解结果" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ResultText}" FontSize="15" FontWeight="SemiBold" Foreground="#FFD48A"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StatsText}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#CCCCCC"/>
                            <TextBlock Text="{Binding MessageText}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#999999"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" Foreground="#888888"/>
                </StackPanel>

                <!-- ══════════ 深度进度表 ══════════ -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0" Background="#18FFFFFF" CornerRadius="10">
                    <StackPanel Margin="12">
                        <TextBlock Text="搜索进度（逐层加深）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid x:Name="DepthGrid" ItemsSource="{Binding DepthRows}" Style="{StaticResource DepthGrid}"
                                  MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="深度" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Depth}" Style="{StaticResource NumCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="最佳着法" Width="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MoveText}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="评分" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Score, StringFormat={}{0:0.00}}" Style="{StaticResource NumCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="本层节点" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nodes, StringFormat={}{0:N0}}" Style="{StaticResource NumCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="累计节点" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NodesTotal, StringFormat={}{0:N0}}" Style="{StaticResource NumCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="TT 命中" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TtHits, StringFormat={}{0:N0}}" Style="{StaticResource NumCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="剪枝" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Cutoffs, StringFormat={}{0:N0}}" Style="{StaticResource NumCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="耗时(秒)" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ElapsedSeconds, StringFormat={}{0:0.00}}" Style="{StaticResource NumCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
