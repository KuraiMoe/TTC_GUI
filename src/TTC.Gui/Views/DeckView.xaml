<UserControl x:Class="TTC.Gui.Views.DeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:TTC.Gui.Controls">
    <UserControl.Resources>
        <Style x:Key="EditorSlotButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
        <StackPanel>
            <TextBlock Text="我的卡组" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="一行 5 个卡位：点击卡位选择卡牌，保存后可在对局中一键载入。"
                       Foreground="#888888" FontSize="12" Margin="0,0,0,12"/>

            <!-- 编辑区：一行 5 张 -->
            <Border Background="#18FFFFFF" CornerRadius="12" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:TextBox Width="240" PlaceholderText="卡组名称…"
                                    Text="{Binding DeckName, UpdateSourceTrigger=PropertyChanged}"/>
                        <ui:Button AutomationProperties.AutomationId="DeckSaveButton" Content="保存卡组"
                                   Appearance="Primary" Command="{Binding SaveCommand}" Margin="10,0,0,0"/>
                        <ui:Button Content="清空编辑区" Command="{Binding ClearEditorCommand}" Margin="10,0,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding EditorSlots}" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource EditorSlotButton}" Click="OnEditorSlotClick"
                                        AutomationProperties.AutomationId="{Binding AutomationKey}"
                                        ToolTip="{Binding Title}">
                                    <controls:CardTile Width="96" Height="118"
                                                       Card="{Binding Card}" Unknown="{Binding Unknown}"
                                                       Accent="{Binding BorderBrush}" BackBrush="{Binding BackgroundBrush}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="已保存的卡组" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/>

            <ItemsControl ItemsSource="{Binding Decks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#18FFFFFF" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Preview}" Foreground="#999999" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- 5 张小图预览 -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cards}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:CardTile Width="58" Height="72" Margin="0,0,6,0"
                                                               Card="{Binding}" Accent="#7A7A7A" BackBrush="#2C2C2C"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="载入到对局" FontSize="12" Padding="10,5" Click="OnUseDeck"/>
                                    <ui:Button Content="编辑" FontSize="12" Padding="10,5" Margin="8,0,0,0" Click="OnEditDeck"/>
                                    <ui:Button Content="删除" Appearance="Secondary" FontSize="12" Padding="10,5"
                                               Margin="8,0,0,0" Click="OnDeleteDeck"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" Foreground="#888888"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
